[{"n":"academy-guide","a":"Anthropic","d":"回答完 Claude 用法問題後，從 Academy 推薦對的課程","c":"寫作與文件","u":"s/anthropics__skills/academy-guide.html"},{"n":"algorithmic-art","a":"Anthropic","d":"先寫演算法哲學，再用 p5.js 做可調參數的生成藝術","c":"設計與前端","u":"s/anthropics__skills/algorithmic-art.html"},{"n":"brand-guidelines","a":"Anthropic","d":"把 Anthropic 官方品牌色和字體套到各種產出物上","c":"設計與前端","u":"s/anthropics__skills/brand-guidelines.html"},{"n":"canvas-design","a":"Anthropic","d":"先寫設計哲學，再把它畫成海報或藝術作品的 PNG、PDF","c":"設計與前端","u":"s/anthropics__skills/canvas-design.html"},{"n":"claude-api","a":"Anthropic","d":"Claude API 與 SDK 的完整參考，含 model、thinking、caching、tool use 和 Managed Agents","c":"Agent 與工作流","u":"s/anthropics__skills/claude-api.html"},{"n":"discernment-nudge","a":"Anthropic","d":"給完實質建議後，附兩三個追問幫使用者自己查證","c":"寫作與文件","u":"s/anthropics__skills/discernment-nudge.html"},{"n":"doc-coauthoring","a":"Anthropic","d":"三階段帶你寫文件：倒脈絡、逐段精修、找空白 Claude 試讀","c":"寫作與文件","u":"s/anthropics__skills/doc-coauthoring.html"},{"n":"frontend-design","a":"Anthropic","d":"做出有主見、不像 AI 套版的前端設計","c":"設計與前端","u":"s/anthropics__skills/frontend-design.html"},{"n":"internal-comms","a":"Anthropic","d":"依溝通類型載入對應範本，寫 3P 更新、電子報、FAQ 等內部文件","c":"寫作與文件","u":"s/anthropics__skills/internal-comms.html"},{"n":"mcp-builder","a":"Anthropic","d":"分四階段打造讓 LLM 用得順的高品質 MCP server","c":"Agent 與工作流","u":"s/anthropics__skills/mcp-builder.html"},{"n":"skill-creator","a":"Anthropic","d":"寫 skill、跑 eval 對比、迭代改進並最佳化觸發描述","c":"設定與維護","u":"s/anthropics__skills/skill-creator.html"},{"n":"slack-gif-creator","a":"Anthropic","d":"用 PIL 畫動畫，做出符合 Slack 規格的 GIF","c":"設計與前端","u":"s/anthropics__skills/slack-gif-creator.html"},{"n":"theme-factory","a":"Anthropic","d":"從 10 套預設主題挑一套，或即時生成新主題來套用到簡報和文件","c":"設計與前端","u":"s/anthropics__skills/theme-factory.html"},{"n":"web-artifacts-builder","a":"Anthropic","d":"用 React、Tailwind、shadcn/ui 做複雜 artifact，再打包成單一 HTML","c":"設計與前端","u":"s/anthropics__skills/web-artifacts-builder.html"},{"n":"webapp-testing","a":"Anthropic","d":"用 Playwright 腳本測試本機 web app，並用 helper 管理 server","c":"瀏覽器自動化","u":"s/anthropics__skills/webapp-testing.html"},{"n":"agents-sdk","a":"Cloudflare","d":"用 Agents SDK 在 Cloudflare 上建置有狀態的 AI agent","c":"Cloudflare 平台","u":"s/cloudflare__skills/agents-sdk.html"},{"n":"cloudflare","a":"Cloudflare","d":"依需求挑選合適的 Cloudflare 產品並導向對應 skill","c":"Cloudflare 平台","u":"s/cloudflare__skills/cloudflare.html"},{"n":"cloudflare-email-service","a":"Cloudflare","d":"在 Cloudflare 上寄送與轉送 email，處理 Email Service 設定","c":"Cloudflare 平台","u":"s/cloudflare__skills/cloudflare-email-service.html"},{"n":"cloudflare-one","a":"Cloudflare","d":"設計、設定與排查 Cloudflare One 的 Zero Trust 部署","c":"Cloudflare 平台","u":"s/cloudflare__skills/cloudflare-one.html"},{"n":"cloudflare-one-migrations","a":"Cloudflare","d":"規劃從 Zscaler、Palo Alto、VPN 遷移到 Cloudflare One","c":"Cloudflare 平台","u":"s/cloudflare__skills/cloudflare-one-migrations.html"},{"n":"durable-objects","a":"Cloudflare","d":"建置與審查 Durable Objects 的狀態與協調程式碼","c":"Cloudflare 平台","u":"s/cloudflare__skills/durable-objects.html"},{"n":"sandbox-sdk","a":"Cloudflare","d":"用 Sandbox SDK 建置能安全執行程式碼的沙箱環境","c":"Cloudflare 平台","u":"s/cloudflare__skills/sandbox-sdk.html"},{"n":"turnstile-spin","a":"Cloudflare","d":"一步步把 Turnstile 機器人驗證接進前後端並驗證","c":"Cloudflare 平台","u":"s/cloudflare__skills/turnstile-spin.html"},{"n":"web-perf","a":"Cloudflare","d":"用 Chrome DevTools MCP 稽核網站效能與 Core Web Vitals","c":"Cloudflare 平台","u":"s/cloudflare__skills/web-perf.html"},{"n":"workers-best-practices","a":"Cloudflare","d":"照最佳實務撰寫與審查 Cloudflare Workers 程式碼","c":"Cloudflare 平台","u":"s/cloudflare__skills/workers-best-practices.html"},{"n":"wrangler","a":"Cloudflare","d":"安全地執行與排查 Wrangler CLI 指令和部署","c":"Cloudflare 平台","u":"s/cloudflare__skills/wrangler.html"},{"n":"autoplan","a":"Garry Tan","d":"依序跑完 CEO、設計、工程、DX review，用 6 條原則自動做決定","c":"規劃與釐清","u":"s/garrytan__gstack/autoplan.html"},{"n":"benchmark","a":"Garry Tan","d":"用真實頁面數據建 baseline、比對網頁效能有沒有退步","c":"測試與驗證","u":"s/garrytan__gstack/benchmark.html"},{"n":"benchmark-models","a":"Garry Tan","d":"把同一個 prompt 丟給多個 AI 模型比速度、成本和品質","c":"測試與驗證","u":"s/garrytan__gstack/benchmark-models.html"},{"n":"browse","a":"Garry Tan","d":"透過 Aside 驅動真實瀏覽器，開頁面、點流程、截圖、查 console 錯誤","c":"瀏覽器自動化","u":"s/garrytan__gstack/browse.html"},{"n":"canary","a":"Garry Tan","d":"部署後一直盯著 production，抓新的 console 錯誤和效能退步","c":"部署與發布","u":"s/garrytan__gstack/canary.html"},{"n":"careful","a":"Garry Tan","d":"用 PreToolUse hook 攔截 rm -rf、force push 等破壞性指令","c":"安全護欄","u":"s/garrytan__gstack/careful.html"},{"n":"codex","a":"Garry Tan","d":"包裝 OpenAI Codex CLI，用 review、challenge、consult 三種模式拿第二意見","c":"Code Review","u":"s/garrytan__gstack/codex.html"},{"n":"context-restore","a":"Garry Tan","d":"把 /context-save 存下來的工作進度讀回來，接著上次停下的地方做","c":"設定與維護","u":"s/garrytan__gstack/context-restore.html"},{"n":"context-save","a":"Garry Tan","d":"把目前的工作狀態、決定和剩餘事項存成 checkpoint，之後能接著做","c":"設定與維護","u":"s/garrytan__gstack/context-save.html"},{"n":"cso","a":"Garry Tan","d":"有證據的安全稽核，找出能被利用的漏洞並挑戰自己的結論","c":"安全護欄","u":"s/garrytan__gstack/cso.html"},{"n":"design-consultation","a":"Garry Tan","d":"了解產品、研究競品，一起提出完整設計系統並產出 DESIGN.md","c":"設計與前端","u":"s/garrytan__gstack/design-consultation.html"},{"n":"design-html","a":"Garry Tan","d":"把核准的設計稿做成 Pretext 排版、可上線的 HTML/CSS","c":"設計與前端","u":"s/garrytan__gstack/design-html.html"},{"n":"design-review","a":"Garry Tan","d":"用設計師的眼光稽核線上網站，找出問題、逐一修掉並驗證","c":"設計與前端","u":"s/garrytan__gstack/design-review.html"},{"n":"design-shotgun","a":"Garry Tan","d":"一次產生多個 AI 設計變體，用比較看板收回饋再迭代","c":"設計與前端","u":"s/garrytan__gstack/design-shotgun.html"},{"n":"devex-review","a":"Garry Tan","d":"實際操作線上產品，稽核文件、錯誤訊息與上手時間的開發者體驗","c":"測試與驗證","u":"s/garrytan__gstack/devex-review.html"},{"n":"document-release","a":"Garry Tan","d":"發版後稽核並更新 README、CHANGELOG 等文件，確保跟程式碼一致","c":"寫作與文件","u":"s/garrytan__gstack/document-release.html"},{"n":"freeze","a":"Garry Tan","d":"把這個 session 的檔案編輯鎖在指定目錄，目錄外一律擋掉","c":"安全護欄","u":"s/garrytan__gstack/freeze.html"},{"n":"gstack","a":"Garry Tan","d":"gstack 全套 skill 的路由器，依需求把請求導到對的 skill","c":"Agent 與工作流","u":"s/garrytan__gstack/gstack.html"},{"n":"gstack-upgrade","a":"Garry Tan","d":"把 gstack 升級到最新版，處理各種安裝類型並顯示更新內容","c":"設定與維護","u":"s/garrytan__gstack/gstack-upgrade.html"},{"n":"guard","a":"Garry Tan","d":"同時開破壞性指令警告和限定目錄編輯的完整安全模式","c":"安全護欄","u":"s/garrytan__gstack/guard.html"},{"n":"health","a":"Garry Tan","d":"跑完型別、lint、測試等工具，打分數並追蹤程式碼品質趨勢","c":"測試與驗證","u":"s/garrytan__gstack/health.html"},{"n":"investigate","a":"Garry Tan","d":"出現失敗或錯誤時先找根本原因再修，附範圍鎖定和除錯報告","c":"除錯與調查","u":"s/garrytan__gstack/investigate.html"},{"n":"land-and-deploy","a":"Garry Tan","d":"merge 已核准的 PR、等 CI 與 deploy、驗證 production 並出報告","c":"部署與發布","u":"s/garrytan__gstack/land-and-deploy.html"},{"n":"learn","a":"Garry Tan","d":"查看、搜尋、新增、整理這個專案累積的 learnings","c":"設定與維護","u":"s/garrytan__gstack/learn.html"},{"n":"make-pdf","a":"Garry Tan","d":"把 markdown 轉成有封面、目錄、浮水印的出版品質 PDF","c":"Office 與 PDF","u":"s/garrytan__gstack/make-pdf.html"},{"n":"office-hours","a":"Garry Tan","d":"扮演 YC office hours 夥伴，先把問題想清楚再寫設計文件","c":"規劃與釐清","u":"s/garrytan__gstack/office-hours.html"},{"n":"open-gstack-browser","a":"Garry Tan","d":"啟動內建側邊欄的 AI 控制 Chromium，讓你即時看 Claude 操作瀏覽器","c":"瀏覽器自動化","u":"s/garrytan__gstack/open-gstack-browser.html"},{"n":"pair-agent","a":"Garry Tan","d":"發一把一次性 key，讓遠端 AI agent 共用你的瀏覽器","c":"瀏覽器自動化","u":"s/garrytan__gstack/pair-agent.html"},{"n":"plan-ceo-review","a":"Garry Tan","d":"用創辦人視角挑戰 plan 的範圍，選擴張或縮減再逐段 review","c":"規劃與釐清","u":"s/garrytan__gstack/plan-ceo-review.html"},{"n":"plan-design-review","a":"Garry Tan","d":"設計師視角審查計畫，逐項補上缺少的設計決策並打 0-10 分","c":"設計與前端","u":"s/garrytan__gstack/plan-design-review.html"},{"n":"plan-devex-review","a":"Garry Tan","d":"互動式審查計畫的開發者體驗，逼出 persona、上手時間與決策","c":"規劃與釐清","u":"s/garrytan__gstack/plan-devex-review.html"},{"n":"plan-eng-review","a":"Garry Tan","d":"用工程經理的角度審查計畫，檢查架構、測試和範圍再出報告","c":"規劃與釐清","u":"s/garrytan__gstack/plan-eng-review.html"},{"n":"plan-tune","a":"Garry Tan","d":"調整 gstack 問你問題的頻率，並檢視你的開發者輪廓","c":"設定與維護","u":"s/garrytan__gstack/plan-tune.html"},{"n":"qa","a":"Garry Tan","d":"測試網站、API 或 CLI，找出 bug、修掉並驗證，附 regression 測試","c":"測試與驗證","u":"s/garrytan__gstack/qa.html"},{"n":"qa-only","a":"Garry Tan","d":"只做 QA 測試並回報 bug，附證據，絕對不改程式","c":"測試與驗證","u":"s/garrytan__gstack/qa-only.html"},{"n":"retro","a":"Garry Tan","d":"每週工程回顧，用 commit 指標算出節奏、熱點跟成長建議","c":"規劃與釐清","u":"s/garrytan__gstack/retro.html"},{"n":"review","a":"Garry Tan","d":"合併前掃一遍 PR diff，找出測試漏掉的結構問題並修掉","c":"Code Review","u":"s/garrytan__gstack/review.html"},{"n":"setup-browser-cookies","a":"Garry Tan","d":"把真實瀏覽器的 cookie 匯入 headless browse，直接測登入後的頁面","c":"瀏覽器自動化","u":"s/garrytan__gstack/setup-browser-cookies.html"},{"n":"setup-deploy","a":"Garry Tan","d":"偵測 deploy 平台和 production URL，把設定寫進 CLAUDE.md","c":"部署與發布","u":"s/garrytan__gstack/setup-deploy.html"},{"n":"ship","a":"Garry Tan","d":"全自動出貨：merge base、跑測試、review、bump 版本、push 並開 PR","c":"部署與發布","u":"s/garrytan__gstack/ship.html"},{"n":"unfreeze","a":"Garry Tan","d":"清除 /freeze 設的凍結邊界，讓所有目錄都能再編輯","c":"安全護欄","u":"s/garrytan__gstack/unfreeze.html"},{"n":"ask-matt","a":"Matt Pocock","d":"問問哪個 skill 或流程適合你現在的情況","c":"規劃與釐清","u":"s/mattpocock__skills/ask-matt.html"},{"n":"claude-handoff","a":"Matt Pocock","d":"把對話交接給背景 agent，讓它立刻接著做","c":"Agent 與工作流","u":"s/mattpocock__skills/claude-handoff.html"},{"n":"code-review","a":"Matt Pocock","d":"用 Standards 和 Spec 兩個面向平行 review 改動","c":"Code Review","u":"s/mattpocock__skills/code-review.html"},{"n":"codebase-design","a":"Matt Pocock","d":"設計深模組用的共用詞彙，講 seam 和介面","c":"架構與重構","u":"s/mattpocock__skills/codebase-design.html"},{"n":"diagnosing-bugs","a":"Matt Pocock","d":"先建回饋迴圈再假設，一步步診斷難搞的 bug","c":"除錯與調查","u":"s/mattpocock__skills/diagnosing-bugs.html"},{"n":"domain-modeling","a":"Matt Pocock","d":"主動磨利領域術語，維護詞彙表和 ADR","c":"規劃與釐清","u":"s/mattpocock__skills/domain-modeling.html"},{"n":"git-guardrails-claude-code","a":"Matt Pocock","d":"設定 hook 擋掉 git push 等危險指令","c":"安全護欄","u":"s/mattpocock__skills/git-guardrails-claude-code.html"},{"n":"grill-me","a":"Matt Pocock","d":"沒有 repo 時用的無狀態拷問，磨利計畫","c":"規劃與釐清","u":"s/mattpocock__skills/grill-me.html"},{"n":"grill-with-docs","a":"Matt Pocock","d":"拷問想法，同時把詞彙表和 ADR 寫下來","c":"規劃與釐清","u":"s/mattpocock__skills/grill-with-docs.html"},{"n":"grilling","a":"Matt Pocock","d":"用設計樹一輪一輪拷問你的想法，直到沒有任何假設","c":"規劃與釐清","u":"s/mattpocock__skills/grilling.html"},{"n":"handoff","a":"Matt Pocock","d":"把目前對話壓成交接文件給下一個 agent","c":"Agent 與工作流","u":"s/mattpocock__skills/handoff.html"},{"n":"implement","a":"Matt Pocock","d":"照 spec 或 ticket 實作，用 tdd 並收尾 review","c":"測試與驗證","u":"s/mattpocock__skills/implement.html"},{"n":"improve-codebase-architecture","a":"Matt Pocock","d":"掃出可加深的模組，用 HTML 報告呈現再拷問","c":"架構與重構","u":"s/mattpocock__skills/improve-codebase-architecture.html"},{"n":"loop-me","a":"Matt Pocock","d":"拷問你生活中的重複模式，寫成 workflow spec","c":"規劃與釐清","u":"s/mattpocock__skills/loop-me.html"},{"n":"migrate-to-shoehorn","a":"Matt Pocock","d":"把測試裡的 as 斷言換成 shoehorn","c":"測試與驗證","u":"s/mattpocock__skills/migrate-to-shoehorn.html"},{"n":"prototype","a":"Matt Pocock","d":"做用完即丟的 prototype 回答設計問題","c":"設計與前端","u":"s/mattpocock__skills/prototype.html"},{"n":"research","a":"Matt Pocock","d":"丟給背景 agent 查第一手來源並寫成文件","c":"除錯與調查","u":"s/mattpocock__skills/research.html"},{"n":"resolving-merge-conflicts","a":"Matt Pocock","d":"解 merge/rebase 衝突，保留雙方意圖不准 abort","c":"設定與維護","u":"s/mattpocock__skills/resolving-merge-conflicts.html"},{"n":"scaffold-exercises","a":"Matt Pocock","d":"建立能通過 lint 的練習題目錄結構","c":"設定與維護","u":"s/mattpocock__skills/scaffold-exercises.html"},{"n":"setup-matt-pocock-skills","a":"Matt Pocock","d":"設定 issue tracker、triage 標籤和文件版面","c":"設定與維護","u":"s/mattpocock__skills/setup-matt-pocock-skills.html"},{"n":"setup-pre-commit","a":"Matt Pocock","d":"設定 Husky 加 lint-staged 的 pre-commit hook","c":"設定與維護","u":"s/mattpocock__skills/setup-pre-commit.html"},{"n":"setup-ts-deep-modules","a":"Matt Pocock","d":"用 dependency-cruiser 強制每個 package 是深模組","c":"架構與重構","u":"s/mattpocock__skills/setup-ts-deep-modules.html"},{"n":"tdd","a":"Matt Pocock","d":"紅綠迴圈、只在講好的 seam 上測、三種測試反模式","c":"測試與驗證","u":"s/mattpocock__skills/tdd.html"},{"n":"teach","a":"Matt Pocock","d":"在 workspace 裡跨多次 session 教你新概念","c":"寫作與文件","u":"s/mattpocock__skills/teach.html"},{"n":"to-questionnaire","a":"Matt Pocock","d":"把你答不出來的決策變成問卷給別人填","c":"規劃與釐清","u":"s/mattpocock__skills/to-questionnaire.html"},{"n":"to-spec","a":"Matt Pocock","d":"把目前對話整理成 spec 並發佈到 issue tracker","c":"規劃與釐清","u":"s/mattpocock__skills/to-spec.html"},{"n":"to-tickets","a":"Matt Pocock","d":"把計畫拆成帶 blocking 關係的垂直切片 ticket","c":"規劃與釐清","u":"s/mattpocock__skills/to-tickets.html"},{"n":"triage","a":"Matt Pocock","d":"讓 issue 和外部 PR 走過 triage 狀態機","c":"規劃與釐清","u":"s/mattpocock__skills/triage.html"},{"n":"wait-what","a":"Matt Pocock","d":"上一則沒講清楚時，用簡單英文重新 pitch","c":"寫作與文件","u":"s/mattpocock__skills/wait-what.html"},{"n":"wayfinder","a":"Matt Pocock","d":"把大到一個 session 裝不下的工作畫成決策地圖","c":"規劃與釐清","u":"s/mattpocock__skills/wayfinder.html"},{"n":"wizard","a":"Matt Pocock","d":"產生互動式 bash 腳本，帶你做只有人能做的步驟","c":"部署與發布","u":"s/mattpocock__skills/wizard.html"},{"n":"writing-beats","a":"Matt Pocock","d":"把素材一個 beat 一個 beat 組成有地基的文章","c":"寫作與文件","u":"s/mattpocock__skills/writing-beats.html"},{"n":"writing-for-agents","a":"Matt Pocock","d":"寫給 agent 看的文件，講 context 指標和修剪","c":"寫作與文件","u":"s/mattpocock__skills/writing-for-agents.html"},{"n":"writing-fragments","a":"Matt Pocock","d":"用拷問挖出原始寫作片段，先不管結構","c":"寫作與文件","u":"s/mattpocock__skills/writing-fragments.html"},{"n":"writing-shape","a":"Matt Pocock","d":"把素材堆一段一段塑造成一篇文章","c":"寫作與文件","u":"s/mattpocock__skills/writing-shape.html"},{"n":"verification-before-completion","a":"Jesse Vincent","d":"沒跑過驗證指令，不准說完成","c":"測試與驗證","u":"s/obra__superpowers/verification-before-completion.html"}]